# ============================================================================
# bot-telegram — contoh konfigurasi
# Salin ke .env lalu isi nilainya:  cp .env.example .env
# Di Vercel, variabel ini diisi lewat dashboard (Settings -> Environment Variables)
# ============================================================================

# ==== Telegram ====
# Ambil dari @BotFather: /newbot -> copy token di sini
BOT_TOKEN=
# ID Telegram yang boleh pakai command admin, pisahkan dengan koma.
# Cek ID kamu dengan /id setelah bot jalan.
ADMIN_IDS=

# ==== Mode jalan ====
# polling = proses panjang (laptop/VPS), bot menarik update sendiri. Default di lokal.
# webhook = Telegram yang mem-POST update ke HTTP endpoint. WAJIB untuk Vercel.
# Kalau kosong: otomatis "polling" (atau "webhook" bila SERVERLESS/VERCEL aktif).
# MODE=polling

# Tandai bahwa ini lingkungan serverless (tanpa proses panjang) selain Vercel.
# Mempengaruhi default: mode=webhook, store=redis, DB di /tmp, batas waktu AI.
# Vercel mengeset VERCEL=1 otomatis, jadi tidak perlu diisi di sana.
# SERVERLESS=false

# ==== Penyimpanan ====
# sqlite = file lokal, paling simpel untuk development (default di lokal).
# redis  = Upstash Redis REST, wajib untuk serverless (Vercel) karena
#          filesystem-nya sementara dan tidak dibagi antar instance.
# STORE_DRIVER=sqlite

# ---- Redis / Upstash (isi kalau STORE_DRIVER=redis atau di Vercel) ----
# Ambil dari https://console.upstash.com -> Redis -> REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Awalan semua kunci di Redis (biar satu database bisa dipakai beberapa bot)
REDIS_PREFIX=bot:
REDIS_TIMEOUT_MS=10000
REDIS_RETRIES=1

# ---- SQLite (isi kalau STORE_DRIVER=sqlite) ----
DB_PATH=data/bot.db

# ==== Webhook (mode webhook) ====
# String acak rahasia; Telegram mengirimnya di header
# X-Telegram-Bot-Api-Secret-Token sebagai bukti request asli.
# Buat dengan: openssl rand -hex 24
WEBHOOK_SECRET=
# Kunci untuk endpoint /api/setup (atur/hapus webhook tanpa terminal).
# Kalau kosong, /api/setup menolak semua request (aman).
SETUP_SECRET=
# Batas waktu pemrosesan satu update oleh endpoint webhook (ms)
WEBHOOK_TIMEOUT_MS=55000
# Hapus update yang menumpuk saat webhook didaftarkan ulang
WEBHOOK_DROP_PENDING=false
# Tipe update yang dikirim Telegram (kosong = default: message, edited_message,
# callback_query, my_chat_member)
WEBHOOK_ALLOWED_UPDATES=
# URL publik aplikasi (untuk daftar webhook). Di Vercel biasanya otomatis.
PUBLIC_URL=
# Port server webhook lokal (npm run start:webhook)
PORT=3000

# ==== 9Router (gateway AI) ====
# Di lokal: http://localhost:20128
# Di Vercel: WAJIB URL publik (localhost tidak bisa dijangkau dari cloud).
# Kalau tidak terjangkau, bot tetap jalan dan AI membalas "AI sedang offline".
NINEROUTER_URL=http://localhost:20128
NINEROUTER_API_KEY=
# Model default. Combo "free"/"code" ditolak untuk client luar OpenCode,
# jadi pakai model konkret. Lihat daftar: curl -s $NINEROUTER_URL/v1/models
# Terbukti jalan di mesin ini: gh/gpt-4o-mini, gh/gpt-4.1
NINEROUTER_MODEL=gh/gpt-4o-mini
NINEROUTER_TIMEOUT_MS=120000
NINEROUTER_MAX_RETRIES=2

# ==== AI ====
AI_ENABLED=true
AI_STREAM=true
AI_HISTORY_LIMIT=40
AI_CONTEXT_MESSAGES=12
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.7
AI_EDIT_INTERVAL_MS=1200
# Batas waktu satu balasan AI (ms). 0 = tanpa batas.
# Di Vercel otomatis 45000 karena function dibatasi 60 detik.
AI_TIME_BUDGET_MS=
# AI_SYSTEM_PROMPT=Kamu adalah asisten AI di dalam bot Telegram.
# AI_PLACEHOLDER=🤖 <i>sedang berpikir…</i>

# ==== Session ====
SESSION_TTL_MS=43200000
SESSION_CLEANUP_INTERVAL_MS=3600000

# ==== Lain-lain ====
BROADCAST_DELAY_MS=60
MAX_BROADCAST_RECIPIENTS=2000
LOG_LEVEL=info
